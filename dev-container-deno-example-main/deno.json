{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "tasks": {
    "dev": "deno run -A npm:vite@8.2.2",
    "build": "deno task typecheck && deno run -A npm:vite@8.2.2 build",
    "preview": "deno run -A npm:vite@8.2.2 preview",
    "typecheck": "deno run -A npm:typescript@6.0.3/bin/tsc -b",
    "check": "deno fmt --check && deno lint && deno task typecheck && deno check tests/greeting_test.ts",
    "test": "deno test",
    "test:watch": "deno test --watch",
    "ci": "deno task check && deno task test && deno task build"
  },
  "nodeModulesDir": "auto",
  "preferPackageJson": true,
  "minimumDependencyAge": "P1D",
  "lock": {
    "path": "./deno.lock",
    "frozen": true
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "exclude": ["dist/", "node_modules/"]
  },
  "lint": {
    "include": ["src/", "tests/", "vite.config.ts"],
    "rules": {
      "tags": ["recommended"]
    }
  }
}
